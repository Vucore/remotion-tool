{
  "name": "khung-image-video-editor",
  "version": "0.2.0",
  "description": "Web editor tiếng Việt: ghép ảnh tĩnh thành video bằng Remotion",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
