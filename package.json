  "private": true,
  "dependencies": {
    "@remotion/bundler": "4.0.537",
    "@remotion/effects": "4.0.537",
    "@remotion/player": "4.0.537",
    "@remotion/renderer": "4.0.537",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.537"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.537",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/web": "0.0.166",
    "esbuild": "0.28.1",
    "eslint": "10.12.0",
